# --- App ---
ENVIRONMENT=dev
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roomiema
DB_ECHO=false

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (used in email links) ---
FRONTEND_URL=http://localhost:5173

# --- Optional integrations ---
# Without these, uploads go to ./uploads and emails are logged to stdout.
CLOUDINARY_URL=
BREVO_API_KEY=
EMAIL_FROM=no-reply@roomiema.ma
EMAIL_FROM_NAME=RoomieMA
